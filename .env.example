NUXT_BACKEND_API_URL=http://localhost:5180
# Exact externally visible scheme/host/port; required for production mutations.
# Reverse proxies must preserve browser Origin. Forwarded headers do not establish trust.
NUXT_PUBLIC_ORIGIN=http://localhost:3000
# Optional comma-separated exact HTTPS origins approved for remote message media.
# Empty means remote attachments are unavailable; authenticated BFF/blob media works.
NUXT_PUBLIC_APPROVED_MEDIA_ORIGINS=
NUXT_PUBLIC_APP_NAME=CureFlow
